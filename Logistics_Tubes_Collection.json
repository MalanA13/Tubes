	"item": [
		{
			"name": "1. Hub Service",
			"item": [
				{
					"name": "Scan-In (Paket Masuk Hub)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"resi_id\": \"{{resi_id}}\",\r\n    \"hub_id\": \"HUB-JAKARTA-01\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{hub_url}}/hub/scan-in",
							"host": [
								"{{hub_url}}"
							],
							"path": [
								"hub",
								"scan-in"
							]
						}
					},
					"response": []
				},
				{
					"name": "Scan-Out (Paket Keluar Hub)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"resi_id\": \"{{resi_id}}\",\r\n    \"hub_id\": \"HUB-JAKARTA-01\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{hub_url}}/hub/scan-out",
