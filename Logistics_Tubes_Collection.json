					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"resi_id\": \"{{resi_id}}\",\r\n    \"courier_id\": \"KURIR-BUDI-123\"\r\n}",
